rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les documents utilisateurs : lecture pour tous les utilisateurs authentifiés (pour le Lobby),
    // écriture strictement réservée au propriétaire du compte users/{userId}.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
